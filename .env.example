# break FAST — backend environment variables
# Copy this file to .env (repo root) and adjust as needed. Every variable is
# optional; the values below are the defaults used for local development.

# --- Ollama (local LLM) ------------------------------------------------------
# Where the Ollama server is listening, and which model to use.
# Pull the model first: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Database ----------------------------------------------------------------
# SQLite file path, relative to the backend/ directory the server runs from.
DATABASE_PATH=./breakFAST.db

# --- CORS --------------------------------------------------------------------
# Comma-separated origins allowed to call the API. Add your LAN or Tailscale
# address if you open the dev frontend from another device,
# e.g. http://localhost:5173,http://100.x.x.x:5173
# Leaving it unset allows any origin ("*").
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Production mode ---------------------------------------------------------
# true = FastAPI also serves the built frontend from frontend/dist on port 8000
# (one server, one port). Leave false when using the Vite dev server.
SERVE_FRONTEND=false

# --- Demo account ------------------------------------------------------------
# true = create a "demo" user with an empty PIN on startup, handy for trying
# the app locally. Keep false on any instance other people can reach.
DEMO_USER=false

# --- Frontend ----------------------------------------------------------------
# The frontend reads VITE_BACKEND_URL from frontend/.env.* files, not this one.
# Dev defaults to http://localhost:8000; frontend/.env.production leaves it
# empty so the built app calls whichever host served it.
