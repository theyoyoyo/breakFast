# break FAST — backend environment variables
# Copy this file to .env (repo root) and adjust as needed. Every variable is
# optional; the values below are the defaults used for local development.

# --- Ollama (local LLM) ------------------------------------------------------
# Where the Ollama server is listening, and which model to use.
# Pull the model first: ollama pull gemma4:e4b-it-qat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
# Ollama's think field for every call: true, false, or unset for each model's own
# default (Ollama refuses it for a model that can't think). Left unset, the default
# model still runs with false; set it only to force one value on every model.
# OLLAMA_THINK=false
# Optional: a model for one task (CHAT, SUGGESTION, REVIEW, ANALYST, SHOPPING, PLAN,
# WEEKLY) or reply language (EN, TR), with its own think value (unset uses
# OLLAMA_THINK, so leave that unset if this model can't think). A call uses its
# language's model, else its task's, else OLLAMA_MODEL. Two models that don't fit
# the GPU together reload at every switch. See docs/SETUPALL.md.
# OLLAMA_MODEL_SHOPPING=gemma4:e2b-it-q4_K_M
# OLLAMA_THINK_SHOPPING=true
# Context length (tokens) sent with every call. Chat history needs about 6000,
# Ollama's own default is 4096. See docs/SETUPALL.md for the GPU memory it takes.
OLLAMA_NUM_CTX=8192
# Seconds a call may wait for Ollama. A JSON reply comes all at once, so a model that
# thinks first must finish within it.
OLLAMA_TIMEOUT=150

# --- Database ----------------------------------------------------------------
# SQLite file path, relative to the backend/ directory (whatever folder the server starts from).
DATABASE_PATH=./breakFAST.db

# --- CORS --------------------------------------------------------------------
# Comma-separated origins allowed to call the API. Add your LAN or Tailscale
# address if you open the dev frontend from another device,
# e.g. http://localhost:5173,http://100.x.x.x:5173
# Leaving it unset allows any origin ("*").
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Production mode ---------------------------------------------------------
# true = FastAPI also serves the built frontend from frontend/dist on port 8000
# (one server, one port). Leave false when using the Vite dev server.
SERVE_FRONTEND=false

# --- API docs ----------------------------------------------------------------
# true = serve FastAPI's /docs, /redoc and /openapi.json. Leave false unless you
# are developing against the API.
API_DOCS=false

# --- Demo account ------------------------------------------------------------
# true = create a "demo" user with an empty PIN and a small starter fridge on
# startup, handy for trying the app locally. Keep false on any instance other
# people can reach.
DEMO_USER=false

# --- Frontend ----------------------------------------------------------------
# The frontend reads VITE_BACKEND_URL from frontend/.env.* files, not this one.
# Dev defaults to http://localhost:8000; frontend/.env.production leaves it
# empty so the built app calls whichever host served it.
