# break FAST — Environment Variables
# Copy this file to .env and fill in your values.

# Ollama configuration (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Anthropic Claude fallback (optional — only used when Ollama is unavailable)
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# Database
DATABASE_PATH=./breakFAST.db

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS origins (comma-separated, include your frontend URL and any Tailscale IP)
# Example: http://localhost:5173,http://100.x.x.x:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
